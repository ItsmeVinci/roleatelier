{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first job search cockpit: aggregate listings, score fit, tailor documents, autofill applications, track the pipeline.",
  "license": "Apache-2.0",
  "author": "JobPilot",
  "productName": "JobPilot",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/main.cjs",
    "build:app": "npm run build:web && npm run build:server && npm run build:electron",
    "start": "tsx server/index.ts",
    "app": "npm run build && tsx server/index.ts --open",
    "desktop": "npm run build:app && electron .",
    "dist": "npm run build:app && electron-builder --win",
    "dist:portable": "npm run build:app && electron-builder --win portable",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^4.22.3",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.jobpilot.desktop",
    "productName": "JobPilot",
    "copyright": "Copyright © 2026 JobPilot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/electron/**/*",
      "dist/server/**/*",
      "dist/web/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/server/**/*",
      "dist/web/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JobPilot",
      "uninstallDisplayName": "JobPilot"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
